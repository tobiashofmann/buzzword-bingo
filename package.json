{
  "name": "de.itsfullofstars.buzzwordbingo",
  "version": "1.0.0",
  "description": "Buzzword Bingo App for SAP related events.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^4.0.33",
    "@sap/ux-ui5-tooling": "1",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "eslint": "^10",
    "@sapui5/types": "~1.153.0",
    "ui5-tooling-transpile": "^3.10.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start-local": "fiori run --config ./ui5-local.yaml --open \"/index.html",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint ./",
    "ts-typecheck": "tsc --noEmit",
    "prestart": "npm run ts-typecheck",
    "prebuild": "npm run ts-typecheck",
    "start": "fiori run --open \"/index.html?sap-ui-xx-viewCache=false\""
  },
  "sapuxLayer": "CUSTOMER_BASE"
}